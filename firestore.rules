rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDoc() {
      return get(userPath()).data;
    }

    function signedInRole() {
      return isAuthenticated() && exists(userPath())
        ? userDoc().role
        : '';
    }

    function signedInStatus() {
      return isAuthenticated() && exists(userPath())
        ? (userDoc().keys().hasAny(['accountStatus'])
            ? userDoc().accountStatus
            : (userDoc().keys().hasAny(['approvalStatus'])
                ? userDoc().approvalStatus
                : 'approved'))
        : '';
    }

    function isApprovedStaff() {
      return signedInStatus() == 'approved' || signedInStatus() == '';
    }

    function isAdmin() {
      return signedInRole() == 'admin' && isApprovedStaff();
    }

    function isOfficial() {
      return signedInRole() == 'official' && isApprovedStaff();
    }

    function isWorker() {
      return signedInRole() == 'worker' && isApprovedStaff();
    }

    function isPublic() {
      return (signedInRole() == 'public' || signedInRole() == 'citizen')
        && isApprovedStaff();
    }

    function isValidRole(role) {
      return role in ['public', 'official', 'worker', 'admin'];
    }

    function hasRequiredUserFields(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt'])
        && data.uid is string
        && data.name is string
        && data.email is string
        && data.role is string
        && data.createdAt is timestamp
        && data.name.size() >= 3
        && data.name.size() <= 80
        && data.email.size() >= 5
        && data.email.size() <= 120;
    }

    function selfCreateStatus(data) {
      return data.accountStatus is string ? data.accountStatus
        : (data.approvalStatus is string ? data.approvalStatus : '');
    }

    function isValidSelfCreate(data) {
      return isAuthenticated()
        && data.uid == request.auth.uid
        && hasRequiredUserFields(data)
        && (
          (data.role == 'public' && selfCreateStatus(data) in ['approved', ''])
          || (data.role == 'worker' && selfCreateStatus(data) == 'pending')
          || (data.role == 'official' && selfCreateStatus(data) == 'pending')
        );
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isOfficial();

      allow create: if (isOwner(userId) && isValidSelfCreate(request.resource.data))
        || (isAdmin() && hasRequiredUserFields(request.resource.data)
            && isValidRole(request.resource.data.role)
            && request.resource.data.role != 'admin');

      allow update: if (isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'uid', 'email', 'createdAt', 'accountStatus', 'approvalStatus']))
        || isAdmin()
        || (isOfficial()
            && resource.data.role == 'worker'
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['accountStatus', 'approvalStatus', 'reviewedBy', 'reviewedAt']));

      allow delete: if isAdmin();
    }

    match /phone_index/{phone} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['email', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string;
      allow delete: if isAdmin();
    }

    match /access_requests/{requestId} {
      allow read: if isAdmin() || isOwner(requestId);
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll(['uid', 'name', 'email', 'employeeId', 'status', 'createdAt']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /workerApplications/{applicationId} {
      allow read: if isAdmin() || isOfficial() || isOwner(applicationId);
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll(['uid', 'name', 'email', 'status', 'createdAt']);
      allow update: if isOfficial() || isAdmin();
      allow delete: if isAdmin();
    }

    match /officialApplications/{applicationId} {
      allow read: if isAdmin() || isOwner(applicationId);
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll(['uid', 'name', 'email', 'status', 'createdAt']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid
        || isOfficial()
        || isAdmin()
        || (isWorker() && resource.data.assignedWorkerId == request.auth.uid)
        || isPublic()
      );

      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.status == 'submitted';

      allow update: if isOfficial() || isAdmin()
        || (isWorker()
            && resource.data.assignedWorkerId == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.assignedWorkerId == resource.data.assignedWorkerId);

      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string;
        allow delete: if isAdmin() || isOwner(resource.data.uid);
      }
    }

    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string;
      allow update, delete: if isOwner(resource.data.uid) || isAdmin();

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string;
        allow delete: if isAdmin() || isOwner(resource.data.uid);
      }
    }

    match /budgets/{budgetId} {
      allow read: if isAuthenticated();
      allow create, update: if isOfficial() || isAdmin();
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated()
        && (resource.data.recipientUid == request.auth.uid || isAdmin() || isOfficial());
      allow create: if isAuthenticated()
        && request.resource.data.recipientUid is string
        && request.resource.data.title is string
        && (isOfficial() || isAdmin()
            || request.resource.data.senderUid == request.auth.uid);
      allow update: if isAuthenticated()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if isAdmin() || resource.data.recipientUid == request.auth.uid;
    }
  }
}
