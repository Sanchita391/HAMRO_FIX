rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isImageOrVideo() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('video/.*');
    }

    function underTenMb() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    match /profile/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isImageOrVideo() && underTenMb();
    }

    match /applications/{kind}/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isSignedIn();
      allow write: if isOwner(userId) && isImageOrVideo() && underTenMb();
    }

    match /reports/{reportId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isImageOrVideo() && underTenMb();
    }

    match /posts/{postId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isImageOrVideo() && underTenMb();
    }

    match /proof/{reportId}/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isImageOrVideo() && underTenMb();
    }
  }
}
